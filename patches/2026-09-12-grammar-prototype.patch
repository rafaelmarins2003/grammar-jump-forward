@@ -120,6 +120,37 @@ static llama_sampler_i llama_sampler_llg_i = {
     /* .copy_state        = */ NULL,
 };
 
+llama_tokens llama_sampler_llg_ff_tokens(llama_sampler * smpl, int32_t n_max) {
+    if (!smpl || smpl->iface != &llama_sampler_llg_i || n_max <= 0) {
+        return {};
+    }
+
+    auto * ctx = (llama_sampler_llg *) smpl->ctx;
+    if (!ctx->grammar) {
+        return {};
+    }
+
+    std::vector<uint32_t> tokens(n_max);
+    const int32_t n = llg_matcher_compute_ff_tokens(ctx->grammar, tokens.data(), tokens.size());
+    const char * error = llg_matcher_get_error(ctx->grammar);
+    if (n < 0 || error) {
+        throw std::runtime_error(error ? error : "llguidance fast-forward failed");
+    }
+
+    llama_tokens result;
+    result.reserve(n);
+    for (int32_t i = 0; i < n; ++i) {
+        if (tokens[i] >= (uint32_t) llama_vocab_n_tokens(ctx->vocab)) {
+            throw std::runtime_error("llguidance returned an invalid token ID");
+        }
+        if (llama_vocab_is_eog(ctx->vocab, tokens[i])) {
+            break;
+        }
+        result.push_back(tokens[i]);
+    }
+    return result;
+}
