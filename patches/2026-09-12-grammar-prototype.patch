 #include <string>
 #include <vector>
 
 static const llama_vocab * vocab;
 
+static void test_ff_output_bound() {
+    const uint32_t lengths[] = { 1, 1, 2 };
+    const uint8_t bytes[] = { 'a', 'b', 0xff, 'e' };
+    LlgTokenizerInit tinit = {};
+    tinit.vocab_size = 3;
+    tinit.tok_eos = 2;
+    tinit.token_lens = lengths;
+    tinit.token_bytes = bytes;
+    tinit.tokenize_fn = [](const void *, const uint8_t * input, size_t length, uint32_t * output, size_t capacity) {
+        for (size_t i = 0; i < std::min(length, capacity); ++i) {
+            output[i] = input[i] == 'a' ? 0 : 1;
+        }
+        return length;
+    };
+    char error[512] = {};
+    auto * tokenizer = llg_new_tokenizer(&tinit, error, sizeof(error));
+    assert(tokenizer);
+    LlgConstraintInit cinit;
+    llg_constraint_init_set_defaults(&cinit, tokenizer);
+    auto * matcher = llg_new_matcher(&cinit, "regex", "abababababababab");
+    assert(!llg_matcher_get_error(matcher));
+
+    std::array<uint32_t, 64> output;
+    output.fill(0xdeadbeef);
+    assert(llg_matcher_compute_ff_tokens(matcher, output.data(), output.size()) > 1);
+    output.fill(0xdeadbeef);
+    assert(llg_matcher_compute_ff_tokens(matcher, output.data(), 1) == 1);
+    assert(output[0] == 0);
+    for (size_t i = 1; i < output.size(); ++i) {
+        assert(output[i] == 0xdeadbeef);
+    }
+    output.fill(0xdeadbeef);
+    assert(llg_matcher_compute_ff_tokens(matcher, output.data(), 0) == 0);
+    assert(output[0] == 0xdeadbeef);
+    llg_free_matcher(matcher);
+    llg_free_tokenizer(tokenizer);
+}
+
+static void test_ff_sampler() {
+    auto * grammar = llama_sampler_init_llg(vocab, "regex", "The quick brown fox jumps over the lazy dog");
+    const auto forced = llama_sampler_llg_ff_tokens(grammar, 32);
+    assert(forced.size() > 1);
+    assert(llama_sampler_llg_ff_tokens(grammar, 1) == llama_tokens{forced[0]});
+    assert(llama_sampler_llg_ff_tokens(grammar, 0).empty());
+    assert(llama_sampler_llg_ff_tokens(grammar, 32) == forced);
+    auto * copy = llama_sampler_clone(grammar);
+    std::vector<llama_token_data> cur(llama_vocab_n_tokens(vocab));
+    for (const auto token : forced) {
+        for (size_t i = 0; i < cur.size(); ++i) {
+            cur[i] = { (llama_token) i, 0.0f, 0.0f };
+        }
+        auto candidates = llama_token_data_array{cur.data(), cur.size(), -1, false};
+        llama_sampler_apply(copy, &candidates);
+        size_t allowed = 0;
+        for (const auto & candidate : cur) {
+            allowed += std::isfinite(candidate.logit);
+        }
+        assert(allowed == 1 && std::isfinite(cur[token].logit));
+        llama_sampler_accept(copy, token);
+    }
+    assert(llama_sampler_llg_ff_tokens(grammar, 32) == forced);
+    llama_sampler_reset(copy);
+    assert(llama_sampler_llg_ff_tokens(copy, 32) == forced);
+    llama_sampler_free(copy);
+    llama_sampler_free(grammar);
+
+    auto * free_grammar = llama_sampler_init_llg(vocab, "regex", "[a-z]+");
+    assert(llama_sampler_llg_ff_tokens(free_grammar, 32).empty());
+    llama_sampler_free(free_grammar);
+    auto * native = llama_sampler_init_grammar(vocab, "root ::= \"abc\"", "root");
+    assert(llama_sampler_llg_ff_tokens(native, 32).empty());
+    llama_sampler_free(native);
+    assert(common_sampler_ff_tokens(nullptr, 32).empty());
+}
